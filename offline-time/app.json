{
  "expo": {
    "name": "오프라인 타임",
    "slug": "offline-time",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "offlinetime",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.offlinetime.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "app.offlinetime.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0F766E",
          "defaultChannel": "offline-time",
          "enableRemoteNotifications": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "맞춤형 광고를 보여 드리기 위해 사용해요. 허용하지 않아도 광고는 표시되고 적립은 그대로예요."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.offlinetime.mobile.ExpoWidgetsTarget",
          "groupIdentifier": "group.app.offlinetime.mobile",
          "enablePushNotifications": false,
          "frequentUpdates": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "25621109-26a9-4329-abbe-2e170f91ab41"
      }
    },
    "owner": "mybeats"
  }
}
