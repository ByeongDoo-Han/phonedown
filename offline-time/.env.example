EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# AdMob rewarded ad units (한 앱·한 광고 단위를 기록 부스터와 주간 상자가 함께 쓴다).
# 비워 두면 Google이 공개한 테스트 광고 단위(TestIds.REWARDED)로 동작한다.
# app.json의 iosAppId·androidAppId는 앱 ID라 광고 단위 ID와 다르다 — 둘 다 교체해야 실제 수익이 잡힌다.
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_ANDROID=

# 약관·개인정보처리방침에 표시할 문의 주소. 비워 두면 기본값 quden04@gmail.com이 나온다.
# 다른 주소로 받을 때만 채우고, 바꿨다면 저장소 루트 docs/*.html의 mailto:와 본문도 함께 맞춘다.
EXPO_PUBLIC_SUPPORT_EMAIL=

# 아래 값은 앱 번들에 들어가지 않는다.
#   ADMOB_APP_ID_IOS / ADMOB_APP_ID_ANDROID  — app.config.ts가 읽는 빌드 환경변수(EAS 환경에 등록).
#                                             production 프로필에서 테스트 ID가 남아 있으면 빌드가 멈춘다.
#   ADMIN_USER_IDS / FULFILLMENT_PROVIDER / GIFTISHOW_*  — Supabase Edge Function secrets.
#                                             `npx supabase secrets set --project-ref <ref> KEY=value`
